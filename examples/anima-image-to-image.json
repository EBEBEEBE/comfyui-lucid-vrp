      "properties": {},
      "widgets_values": [
        "Loaded image can be used in more than just one way: by default, you load an image and it will be automatically encoded to latent, if you also have a vae input connected; however, you can also load an image, but switch `Latent mode` to `Empty`, and use it as a reference only.\n\nYou can also use the image loader outside of this suite; a \"Standalone Image Loader\" is offered without the `canvas` output so you can use it with other workflows."
      ],
      "widgets_values_named": {
        "text": "Loaded image can be used in more than just one way: by default, you load an image and it will be automatically encoded to latent, if you also have a vae input connected; however, you can also load an image, but switch `Latent mode` to `Empty`, and use it as a reference only.\n\nYou can also use the image loader outside of this suite; a \"Standalone Image Loader\" is offered without the `canvas` output so you can use it with other workflows."
      },
      "color": "#432",
      "bgcolor": "#653"
    },
